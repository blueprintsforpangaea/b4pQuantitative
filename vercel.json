{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "routes": [
    { "src": "/items(.*)", "dest": "/api/index.py" },
    { "src": "/kpis(.*)", "dest": "/api/index.py" },
    { "src": "/stock-alerts", "dest": "/api/index.py" },
    { "src": "/requests(.*)", "dest": "/api/index.py" },
    { "src": "/sync-status", "dest": "/api/index.py" },
    { "src": "/health", "dest": "/api/index.py" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
